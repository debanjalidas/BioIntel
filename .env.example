# BioIntel Backend Environment Configuration

# Application
PROJECT_NAME=BioIntel
API_V1_STR=/api/v1
SECRET_KEY=biointel_super_secret_jwt_key_change_in_production_987654321
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL + PostGIS Database Settings
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=biointel_db

# Direct Database URL (Optional override; auto-computed if omitted)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/biointel_db

# CORS Configuration (JSON-encoded list of allowed origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
